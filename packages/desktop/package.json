{
  "name": "osit-desktop",
  "productName": "OS Installation Tool",
  "description": "Portable Windows and Linux USB creator",
  "author": "OS Installation Tool contributors",
  "version": "0.1.0",
  "private": true,
  "main": "build/main.cjs",
  "scripts": {
    "build": "node build.mjs && electron-builder --win portable --x64 --publish never",
    "postbuild": "node publish-local.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "com.osit.usb.desktop",
    "files": ["build/main.cjs"],
    "win": { "artifactName": "OS-Installation-Tool.exe", "icon": "build/os.png" },
    "portable": { "requestExecutionLevel": "admin" }
  }
}
