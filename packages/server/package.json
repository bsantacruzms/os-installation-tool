{
  "name": "@osit/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
